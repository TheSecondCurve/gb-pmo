# gb-pmo 环境变量（.env 不进 git、不进镜像）
# 必填：会话密钥（≥32 位随机，安全启动检查强制）
GB_PMO_SESSION_SECRET=please-generate-a-random-32-bytes-secret-here
# 首次启动 bootstrap 管理员（空库且缺这两个值时拒绝启动）
GB_PMO_ADMIN_USER=boss
GB_PMO_ADMIN_PASS=change-me-on-first-login
GB_PMO_ADMIN_NAME=老板
# 可选
# GB_PMO_DB=/app/data/gb-pmo.db
# GB_PMO_BASE_URL=http://pmo.internal:8086
# PORT=8086
# ENABLE_SCHEDULER=1   # 大脑调度：每小时抽取 / 15 分钟预警 / 日报到点推送
